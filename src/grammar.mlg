DECLARE PLUGIN "camltac.plugin"

{
open Names

(* Term grammar *)
open Procq.Constr
open Procq.Prim

(* Ltac and Ltac2 grammars *)
open Ltac_plugin.Pltac
open Ltac2_plugin.G_ltac2

let ocaml_code = Procq.Entry.make "ocaml_code"

let get_quotation_contents ~loc ~prefix q =
  let sep, contents = Tok.trim_quotation q in
  (* Get location of OCaml code only *)
  let sep_length =
    match sep with
    | Some sep ->
       String.to_seq q
       |> Seq.take_while (fun c -> c = sep)
       |> Seq.length
    | None -> 0
  in
  let start_shift = String.length prefix + sep_length in
  let end_shift = - sep_length in
  let loc = Loc.shift_loc start_shift end_shift loc in
  loc, contents

let check_module_name_char ~loc = function
  | 'a'..'z' | 'A'..'Z' | '0'..'9' | '_' | '\'' -> ()
  | c ->
     CErrors.user_err ~loc (Pp.(str "Character '" ++ str (String.make 1 c) ++ str "' is not allowed in an OCaml module name."))

let check_module_name ~loc (name: string) =
  match String.get name 0 with
  | 'A'..'Z' ->
     String.iteri (fun i c -> check_module_name_char ~loc:(Loc.after loc i 1) c) name;
     name
  | _ ->
    let suggestion = String.capitalize_ascii name in
    CErrors.user_err ~loc (Pp.(str "Module names must be capitalized.\nHint: did you mean " ++ str suggestion ++ str "?"))

}

GRAMMAR EXTEND Gram
GLOBAL:
  ocaml_code term tactic_value ltac2_atom;

  ocaml_code:
    [ [ q = QUOTATION "ocaml:" ->
        { let loc, contents = get_quotation_contents ~loc ~prefix:"ocaml:" q in
	  Snippet.make ~loc contents } ] ]
  ;

  (* OCaml-in-term *)
  term: LEVEL "0"
    [ [ c = ocaml_code -> { Tactic_in_term.from_ocaml c } ] ]
  ;

  (* OCaml-in-Ltac *)
  tactic_value: FIRST
    [ [ c = ocaml_code -> { Tactic_in_Ltac.from_ocaml c } ] ]
  ;

  (* OCaml-in-Ltac2 *)
  ltac2_atom: FIRST
    [ [ c = ocaml_code -> { Tactic_in_Ltac2.from_ocaml c } ] ]
  ;
END

VERNAC ARGUMENT EXTEND ocaml
| [ ocaml_code(c) ] -> { c }
END

VERNAC ARGUMENT EXTEND ocaml_module
| [ ident(m) ] -> { check_module_name ~loc (Id.to_string m), loc }
END

VERNAC ARGUMENT EXTEND ocaml_file
| [ string(file) ] ->
   { let file =
       if Filename.is_relative file then
         let (/) = Filename.concat in
         match loc.fname with
         | InFile { file = rocq_file; _ } -> Sys.getcwd () / Filename.dirname rocq_file / file
         | ToplevelInput -> Sys.getcwd () / file
       else file
     in file, loc }
END

VERNAC COMMAND EXTEND CamltacEval CLASSIFIED AS QUERY
| ![proof_opt_query] [ "Camltac" "Eval" ocaml(snippet) ]
  SYNTERP AS compilation_output
     { Command.compile_snippet Command.Eval snippet }
  -> { fun ~pstate:proof ->
       Command.interpret ?proof Command.Eval compilation_output }
END

VERNAC COMMAND EXTEND CamltacModule CLASSIFIED AS SIDEFF
| #[ locality = Attributes.hint_locality ] [ "Camltac" "Run" ocaml(snippet) ]
  SYNTERP AS synterp_output
     { let cmd = Command.Module { name = None; locality } in
       cmd, Command.compile_snippet cmd snippet }
  -> { let cmd, compilation_output = synterp_output in
       Command.interpret cmd compilation_output }

| #[ locality = Attributes.hint_locality ] [ "Camltac" "Module" ocaml_module(m) ":=" ocaml(snippet) ]
  SYNTERP AS synterp_output
     { let cmd = Command.Module { name = Some m; locality } in
       cmd, Command.compile_snippet cmd snippet }
  -> { let cmd, compilation_output = synterp_output in
       Command.interpret cmd compilation_output }

| #[ locality = Attributes.hint_locality ] [ "Camltac" "Load" ocaml_file(file) ]
  SYNTERP AS synterp_output
     { let filename, loc = file in
       (* [Camltac Load "M.ml"] ≅ [Camltac Module M := ocaml:(<contents of M.ml>)] *)
       let snippet = Snippet.of_file ~loc filename in
       let name = File.module_name filename in
       let cmd = Command.Module { name = Some (name, loc); locality } in
       cmd, Command.compile_snippet cmd snippet }
  -> { let cmd, compilation_output = synterp_output in
       Command.interpret cmd compilation_output }
END

VERNAC COMMAND EXTEND CamltacCheck CLASSIFIED AS QUERY
| [ "Camltac" "Check" ocaml(snippet) ]
  SYNTERP AS compilation_output
     { Command.compile_snippet Command.Check_expression snippet }
  -> { Command.interpret Command.Check_expression compilation_output }

| [ "Camltac" "Check" ocaml_module(m) ]
  SYNTERP AS compilation_output
     { (* [Camltac Check M.] ≅ [Camltac Check ocaml:(include M).] *)
       let module_name, loc = m in
       let snippet = Snippet.make ~loc (Format.sprintf "include %s" module_name) in
       Command.compile_snippet Command.Check_module snippet }
  -> { Command.interpret Command.Check_module compilation_output }

| [ "Camltac" "Check" ocaml_file(file) ]
  SYNTERP AS compilation_output
     { let filename, loc = file in
       let snippet = Snippet.of_file ~loc filename in
       Command.compile_snippet Command.Check_module snippet }
  -> { Command.interpret Command.Check_module compilation_output }
END
